<td id="S4.F4.3.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:-4pt 0.2pt;"><img src="/html/1611.07004/assets/figs/cityscapes_loss_variations_latex/gt_382.jpg" id="S4.F4.g7" class="ltx_graphics ltx_img_landscape" width="137" height="69" alt="Refer to caption"></td>
<td id="S4.F4.3.3.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:-4pt 0.2pt;"><img src="/html/1611.07004/assets/figs/cityscapes_loss_variations_latex/L1_382.jpg" id="S4.F4.g8" class="ltx_graphics ltx_img_landscape" width="137" height="69" alt="Refer to caption"></td>
<td id="S4.F4.3.3.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:-4pt 0.2pt;"><img src="/html/1611.07004/assets/figs/cityscapes_loss_variations_latex/cGAN_382.jpg" id="S4.F4.g9" class="ltx_graphics ltx_img_landscape" width="137" height="69" alt="Refer to caption"></td>
<td id="S4.F4.3.3.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:-4pt 0.2pt;"><img src="/html/1611.07004/assets/figs/cityscapes_loss_variations_latex/L1cGAN_382.jpg" id="S4.F4.g10" class="ltx_graphics ltx_img_landscape" width="137" height="69" alt="Refer to caption"></td></tr>
