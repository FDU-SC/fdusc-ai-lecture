<p id="S2.F3.3.6" class="ltx_p"><span id="S2.F3.3.6.1" class="ltx_text ltx_align_center ltx_inline-block" style="width:7.1pt;"></span> 
<img src="/html/1812.04948/assets/figures/Stylemix/seed1614.jpg" id="S2.F3.g30" class="ltx_graphics ltx_img_square" width="108" height="108" alt="Refer to caption"> <img src="/html/1812.04948/assets/figures/Stylemix/seed1614-middle-var639.jpg" id="S2.F3.g31" class="ltx_graphics ltx_img_square" width="108" height="108" alt="Refer to caption"><img src="/html/1812.04948/assets/figures/Stylemix/seed1614-middle-var701.jpg" id="S2.F3.g32" class="ltx_graphics ltx_img_square" width="108" height="108" alt="Refer to caption"><img src="/html/1812.04948/assets/figures/Stylemix/seed1614-middle-var687.jpg" id="S2.F3.g33" class="ltx_graphics ltx_img_square" width="108" height="108" alt="Refer to caption"><img src="/html/1812.04948/assets/figures/Stylemix/seed1614-middle-var615.jpg" id="S2.F3.g34" class="ltx_graphics ltx_img_square" width="108" height="108" alt="Refer to caption"><img src="/html/1812.04948/assets/figures/Stylemix/seed1614-middle-var2268.jpg" id="S2.F3.g35" class="ltx_graphics ltx_img_square" width="108" height="108" alt="Refer to caption"></p><span class="ltx_inline-block"><svg id="S2.F3.pic3" class="ltx_picture" height="1" overflow="visible" version="1.1" viewBox="0 0 668.8 1" width="668.8"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,1) matrix(1 0 0 -1 0 0) translate(0.28,0) translate(0,0.28)"><path style="fill:none" d="M 0 0 L 668.25 0"></path></g></svg></span>
<p id="S2.F3.3.7" class="ltx_p"><span id="S2.F3.3.7.1" class="ltx_text ltx_align_center ltx_inline-block" style="width:7.1pt;">
<span id="S2.F3.3.7.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:78pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:78.0pt;transform:translate(-35.5pt,-35.5pt) rotate(-90deg) ;">
<span id="S2.F3.3.7.1.1.1" class="ltx_p"><span id="S2.F3.3.7.1.1.1.1" class="ltx_text ltx_align_center ltx_inline-block" style="width:78.0pt;">Fine from B</span></span>
</span></span></span> 
