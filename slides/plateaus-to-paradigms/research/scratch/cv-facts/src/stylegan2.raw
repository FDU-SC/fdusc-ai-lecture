<th id="A6.T5.3.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_l ltx_border_r ltx_border_t"><span id="A6.T5.3.9.1.1" class="ltx_text" style="font-size:80%;">Total</span></th>
