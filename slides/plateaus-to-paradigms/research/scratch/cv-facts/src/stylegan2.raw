<span id="A6.T5.3.1.3.1.1" class="ltx_p ltx_align_center"><span id="A6.T5.3.1.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Electricity (MWh)</span></span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
