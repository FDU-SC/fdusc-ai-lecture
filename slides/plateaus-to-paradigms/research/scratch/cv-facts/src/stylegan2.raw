<span id="A6.T5.3.9.2.1.1" class="ltx_p ltx_align_center"><span id="A6.T5.3.9.2.1.1.1" class="ltx_text" style="font-size:80%;">51.05</span></span>
</span></td>
<td id="A6.T5.3.9.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_b ltx_border_r ltx_border_t">
