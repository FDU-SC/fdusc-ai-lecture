<span id="A5.T16.p2.1.1.1.1.1.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A5.T16.p2.m1" class="ltx_Math" alttext="\mathbb{R}^{h\times w\times c}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mrow><mi>h</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>w</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>c</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{h\times w\times c}</annotation></semantics></math></span></span>
</span>
<span class="ltx_tbody">
<span id="A5.T16.p2.1.1.1.1.1.1.2" class="ltx_tr">
<span id="A5.T16.p2.1.1.1.1.1.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">LayerNorm</span>
<span id="A5.T16.p2.1.1.1.1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A5.T16.p2.m2" class="ltx_Math" alttext="\mathbb{R}^{h\times w\times c}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mrow><mi>h</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>w</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>c</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{h\times w\times c}</annotation></semantics></math></span></span>
<span id="A5.T16.p2.1.1.1.1.1.1.3" class="ltx_tr">
<span id="A5.T16.p2.1.1.1.1.1.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Conv1x1</span>
<span id="A5.T16.p2.1.1.1.1.1.1.3.2" class="ltx_td ltx_align_center"><math id="A5.T16.p2.m3" class="ltx_Math" alttext="\mathbb{R}^{h\times w\times d\cdot n_{h}}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mrow><mrow><mi>h</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>w</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>n</mi><mi>h</mi></msub></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{h\times w\times d\cdot n_{h}}</annotation></semantics></math></span></span>
<span id="A5.T16.p2.1.1.1.1.1.1.4" class="ltx_tr">
<span id="A5.T16.p2.1.1.1.1.1.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Reshape</span>
<span id="A5.T16.p2.1.1.1.1.1.1.4.2" class="ltx_td ltx_align_center"><math id="A5.T16.p2.m4" class="ltx_Math" alttext="\mathbb{R}^{h\cdot w\times d\cdot n_{h}}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mrow><mrow><mrow><mi>h</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>w</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>n</mi><mi>h</mi></msub></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{h\cdot w\times d\cdot n_{h}}</annotation></semantics></math></span></span>
<span id="A5.T16.p2.1.1.1.1.1.1.5" class="ltx_tr">
<span id="A5.T16.p2.1.1.1.1.1.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_rowspan ltx_rowspan_3"><span id="A5.T16.p2.1.1.1.1.1.1.5.1.1" class="ltx_text"><math id="A5.T16.p2.m5" class="ltx_Math" alttext="\times T\begin{cases}\text{SelfAttention}\\
\text{MLP}\\
\text{CrossAttention}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mtext>SelfAttention</mtext></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mtext>MLP</mtext></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mtext>CrossAttention</mtext></mtd><mtd></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">\times T\begin{cases}\text{SelfAttention}\\
\text{MLP}\\
\text{CrossAttention}\end{cases}</annotation></semantics></math></span></span>
