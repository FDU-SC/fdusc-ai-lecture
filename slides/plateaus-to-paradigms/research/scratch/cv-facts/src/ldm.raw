<span id="S4.T4.3.1.1.1.1.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Pixel-DM (<math id="S4.T4.m1" class="ltx_Math" alttext="f1" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">f1</annotation></semantics></math>)</span>
