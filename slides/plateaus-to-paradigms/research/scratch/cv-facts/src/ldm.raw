<div id="A4.T8.p2" class="ltx_para ltx_noindent ltx_align_center">
<div id="A4.T8.p2.1" class="ltx_inline-block ltx_transformed_outer" style="width:447.2pt;height:167.6pt;vertical-align:-82.4pt;"><span class="ltx_transformed_inner" style="transform:translate(-99.2pt,37.2pt) scale(0.7,0.7) ;">
<p id="A4.T8.p2.1.1" class="ltx_p"><span id="A4.T8.p2.1.1.1" class="ltx_text" style="font-size:80%;">
<span id="A4.T8.p2.1.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:645.7pt;height:242pt;vertical-align:-119.0pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
<span id="A4.T8.p2.1.1.1.1.1" class="ltx_p"><span id="A4.T8.p2.1.1.1.1.1.1" class="ltx_text">
<span id="A4.T8.p2.1.1.1.1.1.1.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<span class="ltx_tbody">
<span id="A4.T8.p2.1.1.1.1.1.1.1.1" class="ltx_tr">
<span id="A4.T8.p2.1.1.1.1.1.1.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_tt"><math id="A4.T8.p2.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math></span>
<span id="A4.T8.p2.1.1.1.1.1.1.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_tt"><math id="A4.T8.p2.m2" class="ltx_Math" alttext="|\mathcal{Z}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{Z}|</annotation></semantics></math></span>
<span id="A4.T8.p2.1.1.1.1.1.1.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_tt"><math id="A4.T8.p2.m3" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math></span>
<span id="A4.T8.p2.1.1.1.1.1.1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T8.p2.1.1.1.1.1.1.1.1.4.1" class="ltx_text ltx_font_bold">R-FID</span> <math id="A4.T8.p2.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
<span id="A4.T8.p2.1.1.1.1.1.1.1.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T8.p2.1.1.1.1.1.1.1.1.5.1" class="ltx_text ltx_font_bold">R-IS</span> <math id="A4.T8.p2.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span>
<span id="A4.T8.p2.1.1.1.1.1.1.1.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T8.p2.1.1.1.1.1.1.1.1.6.1" class="ltx_text ltx_font_bold">PSNR</span> <math id="A4.T8.p2.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span>
<span id="A4.T8.p2.1.1.1.1.1.1.1.1.7" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T8.p2.1.1.1.1.1.1.1.1.7.1" class="ltx_text ltx_font_bold">PSIM</span> <math id="A4.T8.p2.m7" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
<span id="A4.T8.p2.1.1.1.1.1.1.1.1.8" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T8.p2.1.1.1.1.1.1.1.1.8.1" class="ltx_text ltx_font_bold">SSIM</span> <math id="A4.T8.p2.m8" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></span>
<span id="A4.T8.p2.1.1.1.1.1.1.1.2" class="ltx_tr">
<span id="A4.T8.p2.1.1.1.1.1.1.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">16 <em id="A4.T8.p2.1.1.1.1.1.1.1.2.1.1" class="ltx_emph ltx_font_italic">VQGAN</em> <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib23" title="" class="ltx_ref">DBLP:journals/corr/abs-2012-09841</a></cite></span>
<span id="A4.T8.p2.1.1.1.1.1.1.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">16384</span>
<span id="A4.T8.p2.1.1.1.1.1.1.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">256</span>
<span id="A4.T8.p2.1.1.1.1.1.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t">4.98</span>
