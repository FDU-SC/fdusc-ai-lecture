<td id="A4.F15.3.3.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.6pt;padding-right:1.6pt;"><img src="/html/2112.10752/assets/img/supplement/rescalingeffects/1_vq.jpg" id="A4.F15.g6" class="ltx_graphics ltx_img_landscape" width="233" height="117" alt="Refer to caption"></td></tr>
<tr id="A4.F15.3.4" class="ltx_tr">
