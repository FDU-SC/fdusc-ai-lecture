<th id="S3.T1.3.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T1.3.1.1.2.1" class="ltx_text" style="font-size:90%;">Layers </span><math id="S3.T1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math></th>
